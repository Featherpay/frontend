# Featherpay frontend environment.
# Copy to .env and fill in for local development.

# Base URL for featherpay/api (used by src/lib/api).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL, used when generating shareable tip links.
NEXT_PUBLIC_SITE_URL=https://featherpay.io

# Payment processor publishable/client key for the hosted card entry.
NEXT_PUBLIC_PAYMENT_PROCESSOR_PUBLIC_KEY=

# Client-side mirrors of API-enforced tip bounds, for immediate UI feedback.
NEXT_PUBLIC_MIN_TIP_CENTS=100
NEXT_PUBLIC_MAX_TIP_CENTS=10000

# Protocol fee in basis points (0 = no fee). If > 0, show a small fee note
# before the submit button.
NEXT_PUBLIC_PROTOCOL_FEE_BPS=0

# Withdrawal daily cap in cents (displayed on the dashboard).
NEXT_PUBLIC_WITHDRAWAL_DAILY_CAP_CENTS=100000

# Analytics provider (noop | <provider-name>). Defaults to noop.
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop